<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="painel" stylesheets="@controle-quartos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projeto_hotel.Controller.Controllerquartos">
   <children>
      <Label fx:id="titleControle" layoutX="49.0" layoutY="59.0" prefHeight="18.0" prefWidth="426.0" styleClass="titulo" text="Controle De Quartos Ocupados ">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <ComboBox fx:id="tipoQuarto" layoutX="111.0" layoutY="111.0" onAction="#filtrar" prefWidth="150.0" styleClass="combo-filtro" />
      <Label fx:id="filtrarQuarto" layoutX="49.0" layoutY="114.0" styleClass="rotulo" text="Filtrar">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Button fx:id="atualizarQuarto" layoutX="362.0" layoutY="111.0" mnemonicParsing="false" onAction="#atualizar" styleClass="botao-atualizar" text="Atualizar" />
      <TableView fx:id="tbHospedes" layoutX="25.0" layoutY="186.0" prefHeight="200.0" prefWidth="550.0" styleClass="tabela-quartos">
        <columns>
          <TableColumn fx:id="ColNQuarto" prefWidth="95.2000732421875" text="N do Quarto" />
          <TableColumn fx:id="ColTipo" prefWidth="137.60003662109375" text=" Tipo" />
            <TableColumn fx:id="ColStatus" prefWidth="155.199951171875" text="Status" />
            <TableColumn fx:id="ColHospede" prefWidth="168.0" text="Hospede" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
